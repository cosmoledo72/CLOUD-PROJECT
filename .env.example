# Copy to .env and replace every secret before the first start.
# Generate secrets with:  openssl rand -hex 32

POSTGRES_PASSWORD=change-me-postgres
# Signs URLs handed to the Document Server (>= 32 chars).
APP_SECRET=change-me-to-a-random-string-of-at-least-32-chars
# Shared with ONLYOFFICE Docs (>= 16 chars).
DOCS_JWT_SECRET=change-me-docs-jwt-secret

# Public addresses. For a server, use real hostnames behind HTTPS, e.g.
# DOCS_PUBLIC_URL=https://docs.example.com and COOKIE_SECURE=true.
DOCS_PUBLIC_URL=http://localhost:8081
WEB_PORT=8080
DOCS_PORT=8081
COOKIE_SECURE=false

# Allow anyone to register a new portal (tenant).
SIGNUP_ENABLED=true
MAX_UPLOAD_MB=512

# Trash auto-purge (days) and login throttling.
TRASH_RETENTION_DAYS=30
LOGIN_ACCOUNT_LIMIT=8
LOGIN_IP_LIMIT=30
SIGNUP_IP_LIMIT=10

# Address users open the portal at (links in invitation and password emails).
# Behind a domain: PUBLIC_URL=https://portal.example.com
PUBLIC_URL=http://localhost:8080

# Optional system-wide SMTP server. Each portal can also set its own server
# in Administration -> Mail. Security: tls (465), starttls (587) or none.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=WorkHub

# Unread notifications are emailed (as one digest) after this many seconds.
NOTIFY_EMAIL_DELAY_SECS=180
